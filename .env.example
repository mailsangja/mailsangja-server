DB_PORT=5432
DB_NAME=mailsangja
DB_USERNAME=mailsangja
DB_PASSWORD=change-me

REDIS_PORT=6379

SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_PUBLISHER_CONFIRM_TYPE=correlated
RABBITMQ_PUBLISHER_RETURNS=true

MAIL_SYNC_EXCHANGE=mailsangja.mail.sync
MAIL_SYNC_QUEUE=mailsangja.mail.sync.gmail.initial
MAIL_SYNC_ROUTING_KEY=mail.sync.gmail.initial
MAIL_SYNC_DLX_EXCHANGE=mailsangja.mail.sync.dlx
MAIL_SYNC_DLX_QUEUE=mailsangja.mail.sync.gmail.initial.dlq
MAIL_SYNC_DLX_ROUTING_KEY=mail.sync.gmail.initial.dlq
MAIL_SYNC_TTL=30m
MAIL_SYNC_RETRY_MAX_ATTEMPTS=3
MAIL_SYNC_CONCURRENCY=1
MAIL_SYNC_PUBLISHER_MANDATORY=true
GOOGLE_PUBSUB_PUSH_OIDC_JWK_SET_URI=https://www.googleapis.com/oauth2/v3/certs
GOOGLE_PUBSUB_PUSH_OIDC_ALLOWED_ISSUER_1=https://accounts.google.com
GOOGLE_PUBSUB_PUSH_OIDC_ALLOWED_ISSUER_2=accounts.google.com
GOOGLE_PUBSUB_PUSH_OIDC_AUDIENCE=your-pubsub-push-audience
GOOGLE_PUBSUB_PUSH_OIDC_ALLOWED_SERVICE_ACCOUNT_EMAIL=

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/mail-accounts/google/callback
GOOGLE_CONNECT_TIMEOUT=3s
GOOGLE_READ_TIMEOUT=5s

API_DOMAIN=api.example.com
CADDY_EMAIL=mail@example.com

CALLBACK_REDIRECT_URI=http://localhost:5173/
