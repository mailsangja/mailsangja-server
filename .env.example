DB_PORT=5432
DB_NAME=mailsangja
DB_USERNAME=mailsangja
DB_PASSWORD=change-me

REDIS_PORT=6379

SERVER_PORT=8080
WORKER_PORT=8081
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
INBOX_API_BASE_URI=http://localhost:8080
MULTIPART_MAX_FILE_SIZE=10MB
MULTIPART_MAX_REQUEST_SIZE=20MB
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_PUBLISHER_CONFIRM_TYPE=correlated
RABBITMQ_PUBLISHER_RETURNS=true

AI_EMBEDDING_PROVIDER=openai
AI_EMBEDDING_DIMENSIONS=1536
AI_VECTORSTORE_TYPE=pgvector
AI_PGVECTOR_TABLE_NAME=vector_store
AI_PGVECTOR_DIMENSIONS=1536
AI_PGVECTOR_INDEX_TYPE=HNSW
AI_PGVECTOR_DISTANCE_TYPE=COSINE_DISTANCE
AI_PGVECTOR_ID_TYPE=UUID
AI_PGVECTOR_INITIALIZE_SCHEMA=true
AI_METADATA_HASH_SECRET=replace-with-random-secret
AI_CHAT_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com
OPENAI_CHAT_API_KEY=your-chat-api-key
OPENAI_CHAT_BASE_URL=https://openrouter.ai/api/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_API_KEY=your-embedding-api-key
OPENAI_EMBEDDING_BASE_URL=https://api.openai.com
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GOOGLE_GENAI_API_KEY=your-google-genai-api-key
GOOGLE_GENAI_CHAT_MODEL=gemini-2.0-flash
GOOGLE_GENAI_EMBEDDING_MODEL=text-embedding-004

# ── RabbitMQ 공통 설정 ──────────────────────────────────────────────────────
MAIL_TASK_EXCHANGE=mailsangja.mail.task
MAIL_TASK_DLX_EXCHANGE=mailsangja.mail.task.dlx
MAIL_TASK_TTL=30m
MAIL_TASK_PUBLISHER_MANDATORY=true

# 재시도 횟수는 코드 상수(MAX_RETRIES=3)로 고정 — 환경변수로 변경 불가
# 백오프 간격 튜닝 (단위: ms)
MAIL_TASK_RETRY_INITIAL_INTERVAL=30000
MAIL_TASK_RETRY_MULTIPLIER=2.0
MAIL_TASK_RETRY_MAX_INTERVAL=300000

# ── 큐별 Concurrency / Prefetch ────────────────────────────────────────────
INITIAL_MAIL_SYNC_CONCURRENCY=3
INITIAL_MAIL_SYNC_PREFETCH=3
INITIAL_MAIL_SYNC_THREAD_BATCH_CONCURRENCY=5
INITIAL_MAIL_SYNC_THREAD_BATCH_PREFETCH=5

GMAIL_MESSAGE_ADDED_CONCURRENCY=3
GMAIL_MESSAGE_ADDED_PREFETCH=3
GMAIL_HISTORY_STATE_CONCURRENCY=5
GMAIL_HISTORY_STATE_PREFETCH=10

WATCH_RENEWAL_CONCURRENCY=2
WATCH_RENEWAL_PREFETCH=2

LABEL_RECLASSIFY_CONCURRENCY=3
LABEL_RECLASSIFY_PREFETCH=3
MAIL_EMBEDDING_CONCURRENCY=3
MAIL_EMBEDDING_PREFETCH=3
REPLY_DRAFT_SUGGESTION_CONCURRENCY=3
REPLY_DRAFT_SUGGESTION_PREFETCH=3

# ── Discord DLQ 알림 ─────────────────────────────────────────────────────
# 미설정 시 알림 발송 안 함 (로컬/테스트 환경)
DISCORD_WEBHOOK_URL=

GOOGLE_GMAIL_WATCH_RENEWAL_ENABLED=false
GOOGLE_GMAIL_WATCH_RENEWAL_CRON=0 0 * * * *
GOOGLE_GMAIL_WATCH_RENEWAL_WINDOW=1d
GOOGLE_GMAIL_WATCH_RENEWAL_BATCH_SIZE=50

GOOGLE_PUBSUB_PUSH_OIDC_JWK_SET_URI=https://www.googleapis.com/oauth2/v3/certs
GOOGLE_PUBSUB_PUSH_OIDC_ALLOWED_ISSUER_1=https://accounts.google.com
GOOGLE_PUBSUB_PUSH_OIDC_ALLOWED_ISSUER_2=accounts.google.com
GOOGLE_PUBSUB_PUSH_OIDC_AUDIENCE=your-pubsub-push-audience
GOOGLE_PUBSUB_PUSH_OIDC_ALLOWED_SERVICE_ACCOUNT_EMAIL=

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/mail-accounts/google/callback
GOOGLE_CONNECT_TIMEOUT=3s
GOOGLE_READ_TIMEOUT=5s
GOOGLE_GMAIL_WATCH_TOPIC_NAME=projects/your-project/topics/your-topic
GOOGLE_GMAIL_WATCH_URI=https://gmail.googleapis.com/gmail/v1/users/me/watch
GOOGLE_GMAIL_WATCH_CONNECT_TIMEOUT=3s
GOOGLE_GMAIL_WATCH_READ_TIMEOUT=5s
GOOGLE_GMAIL_WATCH_LABEL_FILTER_BEHAVIOR=
GOOGLE_GMAIL_RATE_LIMIT_ENABLED=true
GOOGLE_GMAIL_RATE_LIMIT_FAIL_OPEN=true
GOOGLE_GMAIL_RATE_LIMIT_PER_USER_CAPACITY_UNITS=12000
GOOGLE_GMAIL_RATE_LIMIT_PER_USER_REFILL_UNITS_PER_MINUTE=12000
GOOGLE_GMAIL_RATE_LIMIT_KEY_TTL=2m
GOOGLE_GMAIL_INITIAL_SYNC_MAX_THREADS=2000
GOOGLE_GMAIL_INITIAL_SYNC_THREAD_LIST_PAGE_SIZE=500
GOOGLE_GMAIL_MESSAGES_URI=https://gmail.googleapis.com/gmail/v1/users/me/messages
GOOGLE_GMAIL_MESSAGES_CONNECT_TIMEOUT=3s
GOOGLE_GMAIL_MESSAGES_READ_TIMEOUT=5s
GOOGLE_GMAIL_HISTORY_URI=https://gmail.googleapis.com/gmail/v1/users/me/history
GOOGLE_GMAIL_HISTORY_CONNECT_TIMEOUT=3s
GOOGLE_GMAIL_HISTORY_READ_TIMEOUT=5s

API_DOMAIN=api.example.com
CADDY_EMAIL=mail@example.com

CALLBACK_REDIRECT_URI=http://localhost:5173/

MAILSANGJA_FCM_SERVICE_ACCOUNT_KEY_JSON=
MAILSANGJA_FCM_SERVICE_ACCOUNT_KEY_PATH=firebase-key.json
MAILSANGJA_FCM_LOGO_IMAGE_URL=https://www.ajou.ac.kr/_res/ajou/kr/img/intro/img-symbol.png
MAILSANGJA_FCM_THREAD_DETAIL_URL_TEMPLATE=https://mail.ajou.app/mail/inbox?thread={threadId}&message={messageId}

LABEL_DEBOUNCE_SECONDS=60
LABEL_DEBOUNCE_SCHEDULER_DELAY=10
LABEL_DEBOUNCE_RATE_LIMIT_WINDOW=60
LABEL_DEBOUNCE_RATE_LIMIT_MAX_REQUESTS=20
LABEL_SUGGESTION_RECENT_MAIL_COUNT=20

PORTONE_API_SECRET=your-portone-api-secret
PORTONE_PAYMENT_QUERY_URI=https://api.portone.io/payments
PORTONE_CONNECT_TIMEOUT=3s
PORTONE_READ_TIMEOUT=5s
PORTONE_PLAN_PRICE_PRO=9900

MAILSANGJA_REDIS_RATE_LIMIT_ENABLED=true
MAILSANGJA_REDIS_RATE_LIMIT_MONTHLY_LIMIT=50
